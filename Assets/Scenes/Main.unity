  struggleDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u042F \u0432\u0438\u0436\u0443, \u0442\u044B \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F
      \u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044F\u043C\u0438.
      \u041D\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439!
      \u042F \u0437\u0434\u0435\u0441\u044C, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C
      \u0442\u0435\u0431\u0435!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
    onNodeStart:
      m_PersistentCalls:
