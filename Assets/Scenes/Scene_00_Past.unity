--- !u!114 &454989732
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 454989726}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 005c3f348fb549c4381109fda307130e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  currentStep: 0
  tutorialSceneName: Scene_00_Past
  mainSceneName: Main
  welcomeDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u043C\u0430\u043B\u044B\u0448!
      \u0422\u0432\u043E\u044F \u041A\u0430\u043F\u0441\u0443\u043B\u0430 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0433\u043E
      \u0441\u043D\u0430 \u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F
      \u043F\u043E\u0447\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0430."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0424\u0435\u043E\u0434\u043E\u0440"
    text: "\u041E\u043F\u044F\u0442\u044C \u0443\u0447\u0438\u0442\u044C\u0441\u044F?
      \u042F \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u0438\u0433\u0440\u0430\u0442\u044C
      \u0432\u043E \u0434\u0432\u043E\u0440\u0435!"
    avatarSprite: {fileID: 21300000, guid: e8a55ba8ac1f310438738e14ae538d1f, type: 3}
    isLeftAvatar: 0
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D. \u041D\u043E
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043D\u043E\u043C \u0434\u0430\u0432\u0430\u0439
      \u0440\u0430\u0437\u043E\u043C\u043D\u0435\u043C\u0441\u044F. \u0421\u043E\u0431\u0435\u0440\u0438
      \u0432\u0435\u0442\u043A\u0438 \u0438 \u043A\u0430\u043C\u043D\u0438 \u0434\u043B\u044F
      \u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  gatherStoneDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0432\u0435\u0442\u043A\u0430!
      \u0414\u0430\u0442\u0447\u0438\u043A\u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C
      \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u0434\u0432\u0430 \u043F\u0440\u043E\u0447\u043D\u044B\u0445 \u043A\u0430\u043C\u043D\u044F.
      \u041F\u043E\u0438\u0449\u0438 \u0438\u0445 \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0432 \u0442\u0440\u0430\u0432\u0435 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  openInventoryDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446. \u0412\u0441\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043F\u043E\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F \u0432 \u0442\u0432\u043E\u0439
      \u0443\u043C\u043D\u044B\u0439 \u0440\u044E\u043A\u0437\u0430\u043A."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u043A\u0430\u0440\u043C\u0430\u043D\u044B. \u041D\u0430\u0436\u043C\u0438
      \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\"
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  inventoryExplainedDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0412 \u044D\u0442\u043E\u043C \u043C\u0435\u043D\u044E \u0442\u044B
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0437\u0430\u043F\u0430\u0441\u044B."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0424\u0435\u043E\u0434\u043E\u0440"
    text: "\u0423\u0445 \u0442\u044B! \u0410 \u044F \u043C\u043E\u0433\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0438\u0437 \u044D\u0442\u0438\u0445 \u043A\u0430\u043C\u043D\u0435\u0439
      \u0438 \u043F\u0430\u043B\u043A\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u0441\u0442\u0440\u0435\u043B\u0443?"
    avatarSprite: {fileID: 21300000, guid: e8a55ba8ac1f310438738e14ae538d1f, type: 3}
    isLeftAvatar: 0
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0436\u043C\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
      \"\u0412\u0435\u0440\u0441\u0442\u0430\u043A\" \u2014 \u0442\u0430\u043C \u043C\u044B
      \u0437\u0430\u0439\u043C\u0435\u043C\u0441\u044F \u043A\u0440\u0430\u0444\u0442\u043E\u043C!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  craftingOpenedDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0412 \u044D\u0442\u043E\u0439 \u0431\u0430\u0437\u0435 \u0434\u0430\u043D\u043D\u044B\u0445
      \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0447\u0435\u0440\u0442\u0435\u0436\u0438
      \u0432\u0441\u0435\u0433\u043E, \u0447\u0442\u043E \u043C\u044B \u043A\u043E\u0433\u0434\u0430-\u043B\u0438\u0431\u043E
      \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438 \u0438\u043B\u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0438.
      \u0427\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043D\u043E\u0432\u044B\u0439
      \u0440\u0435\u0446\u0435\u043F\u0442, \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0427\u0442\u043E\u0431\u044B \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C
      \u0434\u0432\u0430 \u043B\u044E\u0431\u044B\u0445 \u0447\u0435\u0440\u0442\u0435\u0436\u0430,
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0436\u043C\u0438 \u043D\u0430
      \u0438\u0445 \u0438\u043A\u043E\u043D\u043A\u0443! \u041F\u0440\u0438\u0447\u0451\u043C
      \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C
      \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0447\u0435\u0440\u0442\u0451\u0436
      \u043F\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0440\u0430\u0437:
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u0434\u0432\u0430 \u043A\u0430\u043C\u043D\u044F!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  arrowRecipeDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0442\u044B \u0443\u0437\u043D\u0430\u043B,
      \u043A\u0430\u043A \u0434\u0435\u043B\u0430\u0442\u044C \u0417\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0441\u0430\u043C \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0440\u0435\u0446\u0435\u043F\u0442
      \u0441\u0442\u0440\u0435\u043B!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  selectRecipeDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F
      \u0443\u0441\u043F\u0435\u0448\u043D\u0430! \u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C,
      \u043A\u0430\u043A \u0434\u0435\u043B\u0430\u0442\u044C \u0417\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0438 \u041A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
      \u0441\u0442\u0440\u0435\u043B\u044B. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0434\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043C
      \u0438\u0445! \u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u0440\u0435\u0446\u0435\u043F\u0442
      \u0417\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u043E\u0433\u043E \u043A\u0430\u043C\u043D\u044F
      \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \u0441\u043B\u0435\u0432\u0430."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  explainCraftButtonDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041E\u0431\u0440\u0430\u0442\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043D\u0430 \u043F\u0440\u0430\u0432\u0443\u044E \u043F\u0430\u043D\u0435\u043B\u044C.
      \u0417\u0434\u0435\u0441\u044C \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u044B\u0435
      \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438 \u0442\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0438\u0445 \u0443 \u0442\u0435\u0431\u044F \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435.
      \u0423 \u0442\u0435\u0431\u044F \u043A\u0430\u043A \u0440\u0430\u0437 \u0435\u0441\u0442\u044C
      2 \u043A\u0430\u043C\u043D\u044F \u0438\u0437 2 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0445!
      \u0416\u043C\u0438 \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \xAB\u0421\u043E\u0437\u0434\u0430\u0442\u044C\xBB."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u0410 \u0437\u0430\u0442\u0435\u043C \u0442\u0430\u043A \u0436\u0435
      \u0441\u043E\u0437\u0434\u0430\u0439 \u0436\u0435\u043B\u0430\u0435\u043C\u044B\u0435
      \u0441\u0442\u0440\u0435\u043B\u044B!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  finalCraftDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u0437\u0430\u043F\u0443\u0449\u0435\u043D!
      \u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0436\u0434\u0430\u0442\u044C
      \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F
      \u0417\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u043E\u0433\u043E \u043A\u0430\u043C\u043D\u044F
      \u2014 \u043E\u043D \u043D\u0443\u0436\u0435\u043D \u0434\u043B\u044F \u043D\u0430\u043A\u043E\u043D\u0435\u0447\u043D\u0438\u043A\u043E\u0432.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438
      \u0441\u0442\u0440\u0435\u043B\u044B \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E.
      \u042F \u0432 \u0442\u0435\u0431\u044F \u0432\u0435\u0440\u044E!"
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041F\u043E\u0442\u043E\u043C \u0437\u0430\u043A\u0440\u043E\u0439 \u0412\u0435\u0440\u0441\u0442\u0430\u043A,
      \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0436\u0430\u0432 \u043D\u0430
      \u0435\u0433\u043E \u043A\u043D\u043E\u043F\u043A\u0443."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  finalDialogue:
  - speakerName: "\u0420\u043E\u0431\u043E-\u041D\u044F\u043D\u044F"
    text: "\u041F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u0421\u0442\u0440\u0435\u043B\u044B \u0433\u043E\u0442\u043E\u0432\u044B.
      \u0422\u044B \u043E\u0442\u043B\u0438\u0447\u043D\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0441 \u0440\u0430\u0437\u043C\u0438\u043D\u043A\u043E\u0439. \u0410 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0440\u0435\u043C\u044F \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C."
    avatarSprite: {fileID: 21300000, guid: 498a5c1c491b481439e2405bf04458e3, type: 3}
    isLeftAvatar: 1
  - speakerName: "\u0424\u0435\u043E\u0434\u043E\u0440"
    text: "\u041B\u0430\u0434\u043D\u043E-\u043B\u0430\u0434\u043D\u043E, \u0438\u0434\u0443."
    avatarSprite: {fileID: 21300000, guid: e8a55ba8ac1f310438738e14ae538d1f, type: 3}
    isLeftAvatar: 0
  woodObjects:
  - {fileID: 1435794715}
